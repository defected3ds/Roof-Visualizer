# Pick ONE AI backend. With neither key set the app runs in demo mode (echoes your photo).

# Google Gemini image editing (recommended; same key as AI Studio)
GEMINI_API_KEY=
# Optional override; defaults to gemini-nano-banana-2.1 (Nano Banana 2.1),
# falling back to gemini-3.1-flash-image, then gemini-2.5-flash-image
# GEMINI_IMAGE_MODEL=

# Replicate (FLUX.1 Kontext image editing)
REPLICATE_API_TOKEN=
# REPLICATE_MODEL=black-forest-labs/flux-kontext-pro

# Force a backend when both keys are set: gemini | replicate | demo
# AI_PROVIDER=

# Access code customers need to use the app (leave empty for no sign-in)
# APP_PASSWORD=

# Password for the product admin at /admin (admin is off when empty)
# ADMIN_PASSWORD=

# Lets /admin save products permanently to the GitHub repo (needed on Render).
# Fine-grained token with "Contents: Read and write" on this repo.
# GITHUB_TOKEN=
# Repo and branch are detected on Render; set them elsewhere:
# GITHUB_REPO=defected3ds/roof-visualizer
# GITHUB_BRANCH=main

# PORT=3000
