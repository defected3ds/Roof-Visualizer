# Pick ONE AI backend. With neither key set the app runs in demo mode (echoes your photo).

# Google Gemini image editing (recommended; same key as AI Studio)
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.1-flash-image, falling back to gemini-2.5-flash-image
# GEMINI_IMAGE_MODEL=

# Replicate (FLUX.1 Kontext image editing)
REPLICATE_API_TOKEN=
# REPLICATE_MODEL=black-forest-labs/flux-kontext-pro

# Force a backend when both keys are set: gemini | replicate | demo
# AI_PROVIDER=

# PORT=3000
